{
    "$schema": "https://repomix.com/schemas/latest/schema.json",
    "output": {
        "filePath": "repomix-output.md",
        "style": "markdown",
        "compress": true,
        "removeComments": false,
        "removeEmptyLines": true,
        "topFilesLength": 20,
        "showLineNumbers": false
    },
    "include": ["**/*"],
    "ignore": {
        "useGitignore": true,
        "useDefaultPatterns": true,
        "customPatterns": [
            "docs/**",
            "node_modules/**",
            "OLD-INSTRUCTIONS/**",
            "only-reference/**",
            "implementation-plan/**",
            "repomix-output.md",
            "repomix-output.xml",
            "**/*.lock",
            "package-lock.json",
            ".astro/**",
            "public/pagefind/**",
            "graphify-out/**",
            "e2e/**",
            "test-results/**",
            "playwright-report/**"
        ]
    },
    "security": {
        "enableSecurityCheck": true
    }
}
