{
    "name": "awesome-bharat-static",
    "version": "1.0.0",
    "description": "Static site for Awesome Bharat",
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "astro check && astro build --outDir ./docs",
        "preview": "astro preview --outDir ./docs",
        "astro": "astro",
        "check": "astro check && eslint .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{js,ts,mjs,astro,md,mdx,json}\"",
        "prebuild": "npm run format && npm run lint",
        "build.local": "npm run build && npm run preview",
        "postbuild": "npx pagefind --site docs",
        "pack": "npx repomix --config repomix.config.json",
        "scaffold": "node scripts/scaffold-content.mjs",
        "graphify": "python -m graphify . --code-only",
        "graphify:update": "python -m graphify update .",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@astrojs/mdx": "^4.0.0",
        "@astrojs/react": "^6.0.1",
        "@astrojs/rss": "^4.0.9",
        "@astrojs/sitemap": "^3.2.3",
        "@fontsource-variable/fraunces": "^5.2.9",
        "@fontsource-variable/inter": "^5.2.8",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "astro": "^5.16.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.26.0",
        "radix-ui": "^1.6.5",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.6",
        "@eslint/js": "^9.18.0",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/typography": "^0.5.20",
        "@types/node": "^22.10.5",
        "eslint": "^9.18.0",
        "eslint-plugin-astro": "^1.3.2",
        "globals": "^15.14.0",
        "lightningcss": "^1.30.2",
        "pagefind": "^1.5.2",
        "prettier": "^3.4.2",
        "prettier-plugin-astro": "^0.14.1",
        "shadcn": "^4.14.1",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.20.0"
    }
}
