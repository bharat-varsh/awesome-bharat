---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SEO from '@/components/SEO.astro';
import Search from '@/components/Search.astro';
import { ThemeToggle } from '@/components/ThemeToggle';
import Footer from '@/components/Footer.astro';
import { AppSidebarLayout } from '@/components/AppSidebarLayout';
import type { NavItem } from '@/components/AppSidebar';
import brandLogo from '@/assets/images/brand-logo.svg';
import '@/styles/global.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';

export interface Props {
    title: string;
    description: string;
    image?: string;
    article?: boolean;
    publishedTime?: string;
    tags?: string[];
}

const { title, description, image, article = false, publishedTime, tags } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const [
    apps,
    persons,
    companies,
    channels,
    products,
    blogs,
    projects,
    communities,
    podcasts,
    initiatives,
] = (await Promise.all([
    getCollection('apps'),
    getCollection('persons'),
    getCollection('companies'),
    getCollection('channels'),
    getCollection('products'),
    getCollection('blogs'),
    getCollection('projects'),
    getCollection('communities'),
    getCollection('podcasts'),
    getCollection('initiatives'),
])) as [
    Array<CollectionEntry<'apps'>>,
    Array<CollectionEntry<'persons'>>,
    Array<CollectionEntry<'companies'>>,
    Array<CollectionEntry<'channels'>>,
    Array<CollectionEntry<'products'>>,
    Array<CollectionEntry<'blogs'>>,
    Array<CollectionEntry<'projects'>>,
    Array<CollectionEntry<'communities'>>,
    Array<CollectionEntry<'podcasts'>>,
    Array<CollectionEntry<'initiatives'>>,
];

const navItems: NavItem[] = [
    { name: 'Home', href: '/', icon: 'home' },
    { name: 'Domains', href: '/domains', icon: 'domains' },
    {
        name: 'Apps',
        href: '/apps',
        icon: 'apps',
        count: apps.filter((app) => !app.data.draft).length,
    },
    {
        name: 'People',
        href: '/people',
        icon: 'persons',
        count: persons.filter((person) => !person.data.draft).length,
    },
    {
        name: 'Companies',
        href: '/companies',
        icon: 'companies',
        count: companies.filter((company) => !company.data.draft).length,
    },
    {
        name: 'Channels',
        href: '/channels',
        icon: 'channels',
        count: channels.filter((c) => !c.data.draft).length,
    },
    {
        name: 'Products',
        href: '/products',
        icon: 'products',
        count: products.filter((p) => !p.data.draft).length,
    },
    {
        name: 'Blogs',
        href: '/blogs',
        icon: 'blogs',
        count: blogs.filter((b) => !b.data.draft).length,
    },
    {
        name: 'Projects',
        href: '/projects',
        icon: 'projects',
        count: projects.filter((p) => !p.data.draft).length,
    },
    {
        name: 'Communities',
        href: '/communities',
        icon: 'communities',
        count: communities.filter((c) => !c.data.draft).length,
    },
    {
        name: 'Podcasts',
        href: '/podcasts',
        icon: 'podcasts',
        count: podcasts.filter((p) => !p.data.draft).length,
    },
    {
        name: 'Initiatives',
        href: '/initiatives',
        icon: 'initiatives',
        count: initiatives.filter((i) => !i.data.draft).length,
    },
];

const logoSrc = typeof brandLogo === 'string' ? brandLogo : brandLogo.src;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link rel="sitemap" href="sitemap-index.xml" />
        <meta name="generator" content={Astro.generator} />

        <SEO
            title={title}
            description={description}
            canonical={canonicalURL.toString()}
            image={image}
            article={article}
            publishedTime={publishedTime}
            tags={tags}
        />

        <!-- Load theme script -->
        <script is:inline>
            const getThemePreference = () => {
                if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                    return localStorage.getItem('theme');
                }
                return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            };

            const isDarkPreferred = getThemePreference() === 'dark';
            document.documentElement.classList[isDarkPreferred ? 'add' : 'remove']('dark');

            if (typeof localStorage !== 'undefined') {
                const observer = new MutationObserver(() => {
                    const isDarkTheme = document.documentElement.classList.contains('dark');
                    localStorage.setItem('theme', isDarkTheme ? 'dark' : 'light');
                });

                observer.observe(document.documentElement, {
                    attributes: true,
                    attributeFilter: ['class'],
                });
            }
        </script>
    </head>

    <body
        class="bg-neutral-50 dark:bg-neutral-950 text-neutral-900 dark:text-neutral-100 transition-colors"
    >
        <!-- Atmospheric floating particles (from only-reference) -->
        <div id="bg-particles" aria-hidden="true"></div>

        <div class="relative z-10">
            <AppSidebarLayout
                client:load
                items={navItems}
                currentPath={currentPath}
                logoSrc={logoSrc}
            >
                <div slot="headerEnd" class="flex items-center gap-2 sm:gap-4">
                    <div
                        class="w-full max-w-[120px] sm:max-w-[160px] md:max-w-[200px] lg:max-w-[280px]"
                    >
                        <Search />
                    </div>
                    <ThemeToggle client:load />
                </div>

                <div class="flex min-h-[calc(100svh-4rem)] flex-col">
                    <div class="flex-1 overflow-x-hidden min-w-0" data-pagefind-body>
                        <slot />
                    </div>
                    <Footer />
                </div>
            </AppSidebarLayout>
        </div>

        <script src="../scripts/particles.ts"></script>
    </body>
</html>
