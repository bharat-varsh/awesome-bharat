---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Badge } from '@/components/ui/badge';
import { resolveLogo } from '@/utils/imageResolvers.ts';
import { formatCategoryName } from '@/utils/textUtils.ts';

export interface Props {
    title: string;
    description?: string;
    slug: string;
    collection: string; // 'apps' | 'persons' | 'companies' | etc.
    logoSrc?: ImageMetadata;
    domains?: string[];
    categories?: string[];
    ctaLabel?: string | null;
    ctaUrl?: string | null;
    featured?: boolean;
}

const {
    title,
    description,
    slug,
    collection,
    logoSrc,
    domains = [],
    categories = [],
    ctaLabel = null,
    ctaUrl = null,
    featured = false,
} = Astro.props;
const resolvedLogo = logoSrc ?? resolveLogo(slug);
const primaryDomain = domains[0];
const primaryCategory = categories[0];
const showDomainBadge = !!primaryDomain;
const showCategoryBadge = !!primaryCategory && !showDomainBadge; // Only show one badge max

// Handle special case: 'persons' collection maps to '/people' URL path
const urlCollection = collection === 'persons' ? 'people' : collection;
---

<a
    href={`/${urlCollection}/${slug}`}
    class={`ab-card group block min-w-[280px] p-4 ${featured ? 'ab-card--featured' : ''}`}
>
    <div class="flex gap-4">
        <div class="flex-shrink-0">
            <div
                class="flex h-14 w-14 items-center justify-center overflow-hidden rounded-xl bg-neutral-100 dark:bg-white/[0.02]"
            >
                <Image
                    class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-105"
                    src={resolvedLogo}
                    alt={title}
                    format="webp"
                    widths={[56, 96, 128]}
                    sizes="56px"
                />
            </div>
        </div>

        <div class="min-w-0 flex-1">
            <div class="flex items-start justify-between gap-2">
                <h2
                    class="line-clamp-2 text-base font-semibold leading-snug text-gray-900 dark:text-white"
                >
                    {title}
                </h2>
                {featured && <Badge className="flex-shrink-0">Featured</Badge>}
            </div>

            {
                description && (
                    <p class="mt-2 line-clamp-2 text-sm leading-6 text-gray-600 dark:text-gray-400">
                        {description}
                    </p>
                )
            }

            <div class="mt-3 flex flex-wrap gap-2">
                {showDomainBadge && <Badge variant="secondary">{primaryDomain}</Badge>}
                {
                    showCategoryBadge && (
                        <Badge variant="outline">{formatCategoryName(primaryCategory)}</Badge>
                    )
                }
            </div>

            {
                ctaLabel && ctaUrl && (
                    <span class="mt-3 inline-flex items-center text-sm font-medium text-primary-500 transition group-hover:text-primary-600 dark:text-primary-400 dark:group-hover:text-primary-300">
                        {ctaLabel}
                        <svg
                            class="ml-1 h-4 w-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 5l7 7-7 7"
                            />
                        </svg>
                    </span>
                )
            }
        </div>
    </div>
</a>
