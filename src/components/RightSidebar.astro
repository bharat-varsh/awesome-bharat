---
/**
 * Right sidebar shell for detail pages (related content, etc.).
 * Layout styles previously lived in Sidebar.astro (position="right").
 */
---

<aside
    class="flex-shrink-0 scrollbar-hide max-w-6xl px-10 lg:px-4 py-8 lg:py-4 bg-neutral-50 dark:bg-neutral-900 border-gray-200 dark:border-gray-800 lg:block lg:sticky top-16 w-full max-w-4xl lg:max-w-none lg:mx-0 lg:w-64 lg:h-[calc(100vh-4rem)] lg:self-start lg:overflow-y-auto lg:order-last lg:border-l border-t lg:border-t-0"
>
    <div class="space-y-6">
        <slot />
    </div>
</aside>
