---
import { Image } from 'astro:assets';
import { resolveLogo } from '../utils/imageResolvers.ts';
import { getEntryHref } from '../utils/routeUtils.ts';
import type { AnyCollectionEntry } from '@/utils/relatedContent.ts';

interface Props {
    item: AnyCollectionEntry;
    collection: string;
    resolved?: Record<string, AnyCollectionEntry>;
}

const { item, collection } = Astro.props;

const href = getEntryHref(collection, item.slug);
const resolvedImage = resolveLogo(item.slug, item.data.logo);
---

<a href={href} class="ab-card group block w-full p-3">
    <div class="flex flex-col items-center justify-center space-y-2 pt-3">
        <div
            class="h-12 w-12 flex-shrink-0 overflow-hidden rounded-xl bg-neutral-100 dark:bg-white/[0.02]"
        >
            <Image
                class="h-full w-full object-contain"
                src={resolvedImage}
                alt={'title' in item.data ? item.data.title : item.data.name}
                loading="eager"
                format="webp"
            />
        </div>
    </div>

    <h4 class="mt-2 line-clamp-2 text-xs font-medium text-neutral-900 dark:text-neutral-100">
        {'title' in item.data ? item.data.title : item.data.name}
    </h4>
</a>
