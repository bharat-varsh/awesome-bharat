---
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';

export interface Props {
    title: string;
    viewAllHref: string;
    id: string;
}
const { title, viewAllHref, id } = Astro.props;
---

<section class="space-y-4">
    <div class="flex items-center justify-between">
        <h2 class="font-serif text-2xl font-semibold text-neutral-900 dark:text-neutral-100">
            {title}
        </h2>
        <a
            href={viewAllHref}
            class="text-sm font-medium text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300"
        >
            View all →
        </a>
    </div>

    <div class="relative">
        <button
            type="button"
            aria-label="Scroll left"
            class={cn(
                buttonVariants({ variant: 'outline', size: 'icon' }),
                'scroll-left absolute left-0 top-1/2 z-10 hidden size-10 -translate-y-1/2 rounded-full bg-background/90 shadow-card backdrop-blur md:flex'
            )}
            data-scroll-container={id}
        >
            <svg
                class="size-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path>
            </svg>
        </button>

        <div
            id={id}
            role="region"
            aria-label={`${title} — use arrow keys to scroll`}
            tabindex="0"
            class="flex gap-4 overflow-x-auto scroll-smooth pb-2 snap-x snap-mandatory px-1 md:px-12 scrollbar-hide focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 dark:focus-visible:outline-primary-400 rounded-lg"
        >
            <slot />
        </div>

        <button
            type="button"
            aria-label="Scroll right"
            class={cn(
                buttonVariants({ variant: 'outline', size: 'icon' }),
                'scroll-right absolute right-0 top-1/2 z-10 hidden size-10 -translate-y-1/2 rounded-full bg-background/90 shadow-card backdrop-blur md:flex'
            )}
            data-scroll-container={id}
        >
            <svg
                class="size-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"></path>
            </svg>
        </button>
    </div>
</section>

<script is:inline>
    // Keyboard scroll for CardRow containers — scoped via a unique data attribute
    (function () {
        const scriptEl = document.currentScript;
        if (!scriptEl) return;
        const section = scriptEl.closest('section');
        if (!section) return;
        const container = section.querySelector('[role="region"]');
        if (!container) return;
        container.addEventListener('keydown', function (e) {
            if (!(e instanceof KeyboardEvent)) return;
            const scrollAmount = 160;
            if (e.key === 'ArrowRight') {
                e.preventDefault();
                container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            } else if (e.key === 'ArrowLeft') {
                e.preventDefault();
                container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            }
        });
    })();
</script>
