---
import { Badge, badgeVariants } from '@/components/ui/badge';
import { cn } from '@/lib/utils';

export interface StatPill {
    label: string;
    href?: string;
}

export interface Props {
    eyebrow?: string;
    title: string;
    description: string;
    countLabel: string;
    icon?: string;
    pills?: StatPill[];
}

const { eyebrow, title, description, countLabel, icon = '#', pills = [] } = Astro.props;
---

<section
    class="overflow-hidden rounded-2xl border border-neutral-200 bg-white px-6 py-8 shadow-card dark:border-neutral-800 dark:bg-neutral-900 sm:px-8 sm:py-10"
>
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
            {
                eyebrow && (
                    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.15em] text-primary-600 dark:text-primary-400">
                        {eyebrow}
                    </p>
                )
            }
            <div class="flex items-center gap-3">
                <span
                    class="grid h-12 w-12 flex-none place-items-center rounded-xl bg-neutral-100 text-2xl ring-1 ring-neutral-200 dark:bg-neutral-800 dark:ring-neutral-700"
                    aria-hidden="true"
                >
                    {icon}
                </span>
                <h1
                    class="break-words font-serif text-4xl font-semibold leading-tight text-neutral-900 dark:text-white sm:text-5xl"
                >
                    {title}
                </h1>
            </div>
            <p class="mt-4 max-w-2xl text-base leading-7 text-gray-700 dark:text-gray-300">
                {description}
            </p>
        </div>

        <Badge className="h-auto w-fit flex-none px-4 py-2 text-sm font-semibold">
            {countLabel}
        </Badge>
    </div>

    {
        pills.length > 0 && (
            <nav class="mt-6 flex gap-2 overflow-x-auto pb-1" aria-label="Page sections">
                {pills.map((pill) =>
                    pill.href ? (
                        <a
                            href={pill.href}
                            class={cn(
                                badgeVariants({ variant: 'outline' }),
                                'h-auto px-3 py-1.5 text-sm font-semibold'
                            )}
                        >
                            {pill.label}
                        </a>
                    ) : (
                        <Badge
                            variant="outline"
                            className="h-auto px-3 py-1.5 text-sm font-semibold"
                        >
                            {pill.label}
                        </Badge>
                    )
                )}
            </nav>
        )
    }
</section>
