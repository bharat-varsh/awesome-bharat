---
import type { CollectionEntry } from 'astro:content';
import { Badge } from '@/components/ui/badge';

export interface Props {
    entry: CollectionEntry<'domains'>;
}

interface Achieve {
    title: string;
    description: string;
    date?: string;
    source?: string;
    badge?: string;
}

interface CompWithLeaders {
    metric: string;
    india: string | number;
    leaders: Array<{ country: string; value: string | number }>;
    gap?: string;
}

interface Act {
    type?: string;
    title: string;
    description?: string;
    url?: string;
}

interface Ms {
    title: string;
    source?: string;
    sourceUrl?: string;
    date?: string;
    thumbnail?: string;
}

const { entry } = Astro.props;
const data = entry.data;
const hasData =
    (data.achievements && data.achievements.length > 0) ||
    (data.comparisons && data.comparisons.length > 0) ||
    (data.actions && data.actions.length > 0) ||
    (data.milestones && data.milestones.length > 0);

const actionIconMap: Record<string, string> = {
    volunteer: '🤝',
    donate: '💝',
    promote: '📢',
    collaborate: '👥',
    learn: '📖',
};

function getActionIcon(type?: string): string {
    return type && actionIconMap[type] ? actionIconMap[type] : '✨';
}

function parseNum(v: string | number): number {
    return Number(String(v).replace(/[^\d.-]/g, '')) || 0;
}

if (!hasData) return;
---

<section class="mt-14">
    <div class="mb-8 flex items-center gap-3">
        <span class="text-2xl" aria-hidden="true">{data.emoji || '💡'}</span>
        <h2 class="font-serif text-3xl font-bold text-neutral-900 dark:text-neutral-100">
            Opportunities in {data.title}
        </h2>
    </div>

    <div class="space-y-10">
        <!-- Achievements -->
        {
            data.achievements && data.achievements.length > 0 && (
                <div>
                    <h3 class="mb-4 text-lg font-semibold text-neutral-800 dark:text-neutral-200">
                        🏆 Achievements
                    </h3>
                    <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-5">
                        {data.achievements.map((item: Achieve) => (
                            <article class="group relative overflow-hidden rounded-xl border border-amber-200/60 bg-gradient-to-br from-amber-50/80 to-white p-5 ring-1 ring-amber-300/20 transition-all hover:shadow-lg hover:shadow-amber-200/30 dark:border-amber-800/40 dark:from-amber-950/20 dark:to-neutral-900 dark:ring-amber-700/20 dark:hover:shadow-amber-900/20">
                                {item.badge && (
                                    <span class="mb-3 inline-block rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-800 dark:bg-amber-900/60 dark:text-amber-300">
                                        {item.badge}
                                    </span>
                                )}
                                <h4 class="text-base font-bold text-neutral-900 dark:text-neutral-100">
                                    {item.title}
                                </h4>
                                <p class="mt-2 text-sm leading-relaxed text-neutral-700 dark:text-neutral-300">
                                    {item.description}
                                </p>
                                <div class="mt-3 flex items-center gap-3 text-xs text-neutral-500 dark:text-neutral-400">
                                    {item.date && <span>{item.date}</span>}
                                    {item.source && (
                                        <a
                                            href={item.source}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="inline-flex items-center gap-1 font-medium text-primary-600 underline-offset-2 hover:underline dark:text-primary-400"
                                        >
                                            Source
                                            <svg
                                                class="h-3 w-3"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                                />
                                            </svg>
                                        </a>
                                    )}
                                </div>
                            </article>
                        ))}
                    </div>
                </div>
            )
        }

        <!-- Comparisons: India vs World -->
        {
            data.comparisons && data.comparisons.length > 0 && (
                <div>
                    <h3 class="mb-4 text-lg font-semibold text-neutral-800 dark:text-neutral-200">
                        📊 India vs The World
                    </h3>
                    <div class="grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] gap-5">
                        {data.comparisons.map((comp: CompWithLeaders) => {
                            const sorted = [...comp.leaders].sort(
                                (x, y) => parseNum(y.value) - parseNum(x.value)
                            );
                            const maxVal = Math.max(
                                ...sorted.map((l) => parseNum(l.value)),
                                parseNum(comp.india),
                                1
                            );
                            return (
                                <div class="rounded-xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
                                    <h4 class="text-sm font-bold text-neutral-800 dark:text-neutral-200">
                                        {comp.metric}
                                    </h4>
                                    <div class="mt-4 space-y-3">
                                        {sorted.map((leader) => {
                                            const pct = (parseNum(leader.value) / maxVal) * 100;
                                            const isIndia = leader.country === 'India';
                                            return (
                                                <div>
                                                    <div class="mb-1 flex items-center justify-between text-xs">
                                                        <span class="font-semibold text-neutral-700 dark:text-neutral-300">
                                                            {leader.country}
                                                        </span>
                                                        <span class="text-neutral-500 dark:text-neutral-400">
                                                            {leader.value}
                                                        </span>
                                                    </div>
                                                    <div class="h-2 overflow-hidden rounded-full bg-neutral-100 dark:bg-neutral-800">
                                                        <div
                                                            class={`h-full rounded-full transition-all ${
                                                                isIndia
                                                                    ? 'bg-primary-500'
                                                                    : 'bg-neutral-300 dark:bg-neutral-600'
                                                            }`}
                                                            style={`width: ${Math.max(pct, 2)}%`}
                                                        />
                                                    </div>
                                                </div>
                                            );
                                        })}
                                    </div>
                                    {comp.gap && (
                                        <p class="mt-3 text-xs italic text-neutral-600 dark:text-neutral-400">
                                            {comp.gap}
                                        </p>
                                    )}
                                </div>
                            );
                        })}
                    </div>
                </div>
            )
        }

        <!-- Action Cards -->
        {
            data.actions && data.actions.length > 0 && (
                <div>
                    <h3 class="mb-4 text-lg font-semibold text-neutral-800 dark:text-neutral-200">
                        🚀 How You Can Help
                    </h3>
                    <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-5">
                        {data.actions.map((act: Act) => (
                            <div class="rounded-xl border border-emerald-200/60 bg-gradient-to-br from-emerald-50/80 to-white p-5 ring-1 ring-emerald-300/20 transition-all hover:shadow-lg hover:shadow-emerald-200/30 dark:border-emerald-800/40 dark:from-emerald-950/20 dark:to-neutral-900 dark:ring-emerald-700/20 dark:hover:shadow-emerald-900/20">
                                <div class="mb-3 flex items-center gap-2">
                                    <span class="text-xl" aria-hidden="true">
                                        {getActionIcon(act.type)}
                                    </span>
                                    <h4 class="text-sm font-bold text-neutral-900 dark:text-neutral-100">
                                        {act.title}
                                    </h4>
                                </div>
                                {act.description && (
                                    <p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
                                        {act.description}
                                    </p>
                                )}
                                {act.url && (
                                    <a
                                        href={act.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="mt-4 inline-flex items-center gap-1.5 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-emerald-700 dark:bg-emerald-700 dark:hover:bg-emerald-600"
                                    >
                                        Get Started
                                        <svg
                                            class="h-3.5 w-3.5"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                            />
                                        </svg>
                                    </a>
                                )}
                            </div>
                        ))}
                    </div>
                </div>
            )
        }

        <!-- Recent Milestones -->
        {
            data.milestones && data.milestones.length > 0 && (
                <div>
                    <h3 class="mb-4 text-lg font-semibold text-neutral-800 dark:text-neutral-200">
                        📰 Recent Milestones
                    </h3>
                    <div class="space-y-4">
                        {data.milestones.map((ms: Ms) => (
                            <div class="flex items-start gap-4 rounded-xl border border-neutral-200 bg-white p-4 transition-all hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900">
                                <div
                                    class="mt-0.5 grid h-9 w-9 flex-none place-items-center rounded-lg bg-primary-100 text-sm dark:bg-primary-900/40"
                                    aria-hidden="true"
                                >
                                    🏅
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">
                                        {ms.title}
                                    </h4>
                                    <div class="mt-1.5 flex flex-wrap items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
                                        {ms.source && (
                                            <Badge variant="secondary" className="text-xs">
                                                {ms.source}
                                            </Badge>
                                        )}
                                        {ms.date && <span>{ms.date}</span>}
                                    </div>
                                    {ms.sourceUrl && (
                                        <a
                                            href={ms.sourceUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-primary-600 hover:underline dark:text-primary-400"
                                        >
                                            Read more →
                                        </a>
                                    )}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            )
        }
    </div>
</section>
