---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentCardFull from '@/components/ContentCardFull.astro';
import CollectionHero from '@/components/CollectionHero.astro';
import { getPrimaryCTAUrl, getPrimaryCTALabel } from '@/utils/ctaUtils.ts';
import { resolveLogo } from '@/utils/imageResolvers.ts';
import { getDomainMeta } from '@/utils/domainMeta.ts';

const blogs = (await getCollection('blogs')) as Array<CollectionEntry<'blogs'>>;
const visibleBlogs = blogs
    .filter((blog) => !blog.data.draft)
    .sort((a, b) => {
        if (a.data.featured && !b.data.featured) return -1;
        if (!a.data.featured && b.data.featured) return 1;
        return a.data.name.localeCompare(b.data.name);
    });
---

<BaseLayout
    title="Blogs | Awesome Bharat"
    description="Blogs, newsletters, and digital publications telling India's stories"
>
    <div class="max-w-7xl mx-auto px-4 py-10 sm:px-6 lg:px-8">
        <div class="mb-10">
            <CollectionHero
                title="Blogs"
                description="Blogs, newsletters, and digital publications telling India's stories"
                countLabel={`${visibleBlogs.length} blogs`}
                icon="📝"
                eyebrow="Collection"
            />
        </div>

        <div
            class="animate-fade-in grid
        grid-cols-[repeat(auto-fit,minmax(280px,1fr))]
        gap-6"
        >
            {
                visibleBlogs.map((blog) => {
                    const ctaLabel = getPrimaryCTALabel('blogs', blog.data);
                    const ctaUrl = getPrimaryCTAUrl('blogs', blog.data);

                    return (
                        <ContentCardFull
                            title={blog.data.name}
                            description={blog.data.description}
                            slug={blog.slug}
                            collection="blogs"
                            logoSrc={
                                blog.data.logo ? resolveLogo(blog.slug, blog.data.logo) : undefined
                            }
                            domains={(blog.data.domains ?? []).map(
                                (d: string) => getDomainMeta(d).label
                            )}
                            ctaLabel={ctaLabel}
                            ctaUrl={ctaUrl}
                            featured={blog.data.featured}
                        />
                    );
                })
            }
        </div>
    </div>
</BaseLayout>
