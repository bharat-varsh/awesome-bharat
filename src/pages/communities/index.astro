---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentCardFull from '@/components/ContentCardFull.astro';
import CollectionHero from '@/components/CollectionHero.astro';
import { getPrimaryCTAUrl, getPrimaryCTALabel } from '@/utils/ctaUtils.ts';
import { resolveLogo } from '@/utils/imageResolvers.ts';
import { getDomainMeta } from '@/utils/domainMeta.ts';

const communities = (await getCollection('communities')) as Array<CollectionEntry<'communities'>>;
const visibleCommunities = communities
    .filter((community) => !community.data.draft)
    .sort((a, b) => {
        if (a.data.featured && !b.data.featured) return -1;
        if (!a.data.featured && b.data.featured) return 1;
        return a.data.name.localeCompare(b.data.name);
    });
---

<BaseLayout
    title="Communities | Awesome Bharat"
    description="Communities that bring together people around shared passions, professions, and causes"
>
    <div class="max-w-7xl mx-auto px-4 py-10 sm:px-6 lg:px-8">
        <div class="mb-10">
            <CollectionHero
                title="Communities"
                description="Communities that bring together people around shared passions, professions, and causes"
                countLabel={`${visibleCommunities.length} communities`}
                icon="👥"
                eyebrow="Collection"
            />
        </div>

        <div
            class="animate-fade-in grid
        grid-cols-[repeat(auto-fit,minmax(280px,1fr))]
        gap-6"
        >
            {
                visibleCommunities.map((community) => {
                    const ctaLabel = getPrimaryCTALabel('communities', community.data);
                    const ctaUrl = getPrimaryCTAUrl('communities', community.data);

                    return (
                        <ContentCardFull
                            title={community.data.name}
                            description={community.data.description}
                            slug={community.slug}
                            collection="communities"
                            logoSrc={
                                community.data.logo
                                    ? resolveLogo(community.slug, community.data.logo)
                                    : undefined
                            }
                            domains={(community.data.domains ?? []).map(
                                (d: string) => getDomainMeta(d).label
                            )}
                            ctaLabel={ctaLabel}
                            ctaUrl={ctaUrl}
                            featured={community.data.featured}
                        />
                    );
                })
            }
        </div>
    </div>
</BaseLayout>
