---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentCardFull from '@/components/ContentCardFull.astro';
import CollectionHero from '@/components/CollectionHero.astro';
import { getPrimaryCTAUrl, getPrimaryCTALabel } from '@/utils/ctaUtils.ts';
import { resolveLogo } from '@/utils/imageResolvers.ts';
import { getDomainMeta } from '@/utils/domainMeta.ts';

const channels = (await getCollection('channels')) as Array<CollectionEntry<'channels'>>;
const visibleChannels = channels
    .filter((channel) => !channel.data.draft)
    .sort((a, b) => {
        if (a.data.featured && !b.data.featured) return -1;
        if (!a.data.featured && b.data.featured) return 1;
        return a.data.name.localeCompare(b.data.name);
    });
---

<BaseLayout
    title="Channels | Awesome Bharat"
    description="YouTube channels and video creators from India, spanning every genre and language"
>
    <div class="max-w-7xl mx-auto px-4 py-10 sm:px-6 lg:px-8">
        <div class="mb-10">
            <CollectionHero
                title="Channels"
                description="YouTube channels and video creators from India, spanning every genre and language"
                countLabel={`${visibleChannels.length} channels`}
                icon="📺"
                eyebrow="Collection"
            />
        </div>

        <div
            class="animate-fade-in grid
        grid-cols-[repeat(auto-fit,minmax(280px,1fr))]
        gap-6"
        >
            {
                visibleChannels.map((channel) => {
                    const ctaLabel = getPrimaryCTALabel('channels', channel.data);
                    const ctaUrl = getPrimaryCTAUrl('channels', channel.data);

                    return (
                        <ContentCardFull
                            title={channel.data.name}
                            description={channel.data.description}
                            slug={channel.slug}
                            collection="channels"
                            logoSrc={
                                channel.data.logo
                                    ? resolveLogo(channel.slug, channel.data.logo)
                                    : undefined
                            }
                            domains={(channel.data.domains ?? []).map(
                                (d: string) => getDomainMeta(d).label
                            )}
                            ctaLabel={ctaLabel}
                            ctaUrl={ctaUrl}
                            featured={channel.data.featured}
                        />
                    );
                })
            }
        </div>
    </div>
</BaseLayout>
