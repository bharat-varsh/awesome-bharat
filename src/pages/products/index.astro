---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentCardFull from '@/components/ContentCardFull.astro';
import CollectionHero from '@/components/CollectionHero.astro';
import { getPrimaryCTAUrl, getPrimaryCTALabel } from '@/utils/ctaUtils.ts';
import { resolveLogo } from '@/utils/imageResolvers.ts';
import { getDomainMeta } from '@/utils/domainMeta.ts';

const products = (await getCollection('products')) as Array<CollectionEntry<'products'>>;
const visibleProducts = products
    .filter((product) => !product.data.draft)
    .sort((a, b) => {
        if (a.data.featured && !b.data.featured) return -1;
        if (!a.data.featured && b.data.featured) return 1;
        return a.data.name.localeCompare(b.data.name);
    });
---

<BaseLayout
    title="Products | Awesome Bharat"
    description="Indian-made products that have earned their place in homes and hearts across the globe"
>
    <div class="max-w-7xl mx-auto px-4 py-10 sm:px-6 lg:px-8">
        <div class="mb-10">
            <CollectionHero
                title="Products"
                description="Indian-made products that have earned their place in homes and hearts across the globe"
                countLabel={`${visibleProducts.length} products`}
                icon="🛍️"
                eyebrow="Collection"
            />
        </div>

        <div
            class="animate-fade-in grid
        grid-cols-[repeat(auto-fit,minmax(280px,1fr))]
        gap-6"
        >
            {
                visibleProducts.map((product) => {
                    const ctaLabel = getPrimaryCTALabel('products', product.data);
                    const ctaUrl = getPrimaryCTAUrl('products', product.data);

                    return (
                        <ContentCardFull
                            title={product.data.name}
                            description={product.data.description}
                            slug={product.slug}
                            collection="products"
                            logoSrc={
                                product.data.logo
                                    ? resolveLogo(product.slug, product.data.logo)
                                    : undefined
                            }
                            domains={(product.data.domains ?? []).map(
                                (d: string) => getDomainMeta(d).label
                            )}
                            ctaLabel={ctaLabel}
                            ctaUrl={ctaUrl}
                            featured={product.data.featured}
                        />
                    );
                })
            }
        </div>
    </div>
</BaseLayout>
