---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CollectionHero from '@/components/CollectionHero.astro';
import ContentCardFull from '@/components/ContentCardFull.astro';
import { getPrimaryCTAUrl } from '@/utils/ctaUtils.ts';
import { resolveLogo } from '@/utils/imageResolvers.ts';
import { getDomainMeta } from '@/utils/domainMeta.ts';
import { formatCategoryName } from '@/utils/textUtils.ts';
import {
    SCANNED_COLLECTIONS,
    COLLECTION_GROUP_META,
    getEntryTitle,
    getEntryDescription,
    getEntryImage,
    getCollectionUrlPath,
    type ScannedCollection,
    type ScannedEntry,
} from '@/utils/collectionsToScan.ts';

interface CategoryPageProps {
    category: string;
    // one array of entries per scanned collection, in SCANNED_COLLECTIONS order
    groups: Array<{ collection: ScannedCollection; items: ScannedEntry[] }>;
}

// Category emoji mapping
const categoryEmojis: Record<string, string> = {
    art: '🎨',
    beauty: '💄',
    booksAndReference: '📚',
    business: '💼',
    children: '👶',
    comics: '📖',
    communication: '💬',
    dating: '💕',
    education: '🎓',
    entertainment: '🎬',
    events: '📅',
    finance: '💰',
    foodAndDrinks: '🍽️',
    games: '🎮',
    healthAndFitness: '💪',
    house: '🏠',
    libraries: '📚',
    lifestyle: '✨',
    navigation: '🧭',
    medical: '🏥',
    musicAndAudio: '🎵',
    newsAndMagazines: '📰',
    parenting: '👪',
    personalization: '🎨',
    photography: '📷',
    productivity: '🚀',
    shopping: '🛍️',
    social: '👥',
    sports: '⚽',
    tools: '🔧',
    travel: '✈️',
    vehicles: '🚗',
    video: '🎥',
    watchFaces: '⌚',
    weather: '🌤️',
};

export const getStaticPaths = (async () => {
    // Categories are app-specific, so we derive static paths from apps' categories.
    const publishedApps = (await getCollection('apps')).filter(
        (item: CollectionEntry<'apps'>) => !item.data.draft
    );

    // Collect all unique categories from apps
    const categories = new Set<string>();
    for (const app of publishedApps) {
        for (const category of app.data.categories ?? []) {
            categories.add(category);
        }
    }

    // Load every scanned collection, drop drafts.
    const loaded = await Promise.all(
        SCANNED_COLLECTIONS.map(async (name) => {
            const entries = (await getCollection(name)) as ScannedEntry[];
            return {
                collection: name as ScannedCollection,
                entries: entries.filter((e) => !e.data.draft),
            };
        })
    );

    const sortFeaturedFirst = <T extends { data: { featured?: boolean } }>(items: T[]) =>
        [...items].sort(
            (a, b) => Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured))
        );

    return [...categories].map((category) => {
        const hasCategory = (cats: string[] = []) => cats.includes(category);
        // For non-app collections, match category by tags
        const hasCategoryTag = (tags: string[] = []) =>
            tags.some((t: string) => t.toLowerCase() === category.toLowerCase());

        return {
            params: { category },
            props: {
                category,
                groups: loaded.map(({ collection, entries }) => ({
                    collection,
                    items: sortFeaturedFirst(
                        collection === 'apps'
                            ? entries.filter((item) => hasCategory(item.data.categories ?? []))
                            : entries.filter((item) => hasCategoryTag(item.data.tags ?? []))
                    ),
                })),
            },
        };
    });
}) satisfies GetStaticPaths;

const { category, groups } = Astro.props as CategoryPageProps;
const categoryTitle = formatCategoryName(category);
const categoryEmoji = categoryEmojis[category] || '📂';

// Only render groups that actually have matches.
const visibleGroups = groups.filter((g) => g.items.length > 0);
const totalItems = visibleGroups.reduce((sum, g) => sum + g.items.length, 0);
const countLabel = `${totalItems} ${totalItems === 1 ? 'item' : 'items'}`;
const description = `Indian-made apps, people, and companies in ${categoryTitle.toLowerCase()} — tools, resources, and inspiration for your ${categoryTitle.toLowerCase()} journey.`;

const pills = visibleGroups.map((g) => ({
    label: `${COLLECTION_GROUP_META[g.collection].title} (${g.items.length})`,
    href: `#${COLLECTION_GROUP_META[g.collection].id}`,
}));
---

<BaseLayout title={`${categoryTitle} | Awesome Bharat`} description={description} tags={[category]}>
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        <CollectionHero
            eyebrow="Category"
            title={categoryTitle}
            description={description}
            countLabel={countLabel}
            icon={categoryEmoji}
            pills={pills}
        />

        <div class="mt-10 space-y-12">
            {
                visibleGroups.map((group) => {
                    const groupMeta = COLLECTION_GROUP_META[group.collection];
                    return (
                        <section id={groupMeta.id} class="scroll-mt-24">
                            <div class="mb-4 flex items-end justify-between gap-4">
                                <div>
                                    <h2 class="font-serif text-2xl font-extrabold text-neutral-900 dark:text-neutral-100">
                                        {groupMeta.title}
                                    </h2>
                                    <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
                                        {group.items.length}{' '}
                                        {group.items.length === 1 ? 'match' : 'matches'} for{' '}
                                        {categoryTitle}
                                    </p>
                                </div>
                            </div>

                            <div class="flex gap-4 overflow-x-auto pb-4">
                                {group.items.map((item) => (
                                    <ContentCardFull
                                        title={getEntryTitle(item)}
                                        description={getEntryDescription(item)}
                                        slug={item.slug}
                                        collection={getCollectionUrlPath(item.collection)}
                                        logoSrc={
                                            getEntryImage(item)
                                                ? resolveLogo(item.slug, getEntryImage(item))
                                                : undefined
                                        }
                                        domains={(item.data.domains ?? []).map(
                                            (d: string) => getDomainMeta(d).label
                                        )}
                                        categories={
                                            item.collection === 'apps'
                                                ? item.data.categories
                                                : undefined
                                        }
                                        ctaLabel="View More"
                                        ctaUrl={getPrimaryCTAUrl(item.collection, item.data)}
                                        featured={item.data.featured}
                                    />
                                ))}
                            </div>
                        </section>
                    );
                })
            }
        </div>
    </div>
</BaseLayout>
