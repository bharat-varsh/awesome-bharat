---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import type { Author, Link, CompanyMember } from '@/content/config.ts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { resolveLogo } from '@/utils/imageResolvers.ts';
import { getDomainMeta } from '@/utils/domainMeta.ts';
import { Badge } from '@/components/ui/badge';
import { getPrimaryCTALabel, getPrimaryCTAUrl } from '@/utils/ctaUtils.ts';

export const getStaticPaths = (async () => {
    const companies = (await getCollection('companies')) as Array<CollectionEntry<'companies'>>;
    const publishedCompanies = companies.filter((company) => !company.data.draft);

    return publishedCompanies.map((company) => ({
        params: { slug: company.slug },
        props: { company },
    }));
}) satisfies GetStaticPaths;

const { company } = Astro.props as { company: CollectionEntry<'companies'> };
const { Content } = await company.render();

const resolvedImage = resolveLogo(company.slug, company.data.logo);

// Get persons who are members of this company
const persons = (await getCollection('persons')) as Array<CollectionEntry<'persons'>>;
const companyMembers: Array<CollectionEntry<'persons'>> =
    (company.data.members as CompanyMember[] | undefined)
        ?.map((member) => persons.find((person) => person.slug === member.slug))
        .filter((p): p is CollectionEntry<'persons'> => Boolean(p)) ?? [];

// Get apps by this company
const apps = (await getCollection('apps')) as Array<CollectionEntry<'apps'>>;
const appsByCompany = apps.filter(
    (app) =>
        !app.data.draft &&
        app.data.authors.some(
            (author: Author) => author.slug === company.slug && author.type === 'company'
        )
);

const primaryCTAUrl = getPrimaryCTAUrl('companies', { website: company.data.website });
const primaryCTALabel = getPrimaryCTALabel('companies', { website: company.data.website });
---

<BaseLayout
    title={`${company.data.name} | Awesome Bharat`}
    description={company.data.description ?? `${company.data.name} - Featured on Awesome Bharat`}
    image={company.data.logo}
>
    <div class="max-w-4xl mx-auto px-4 py-10 sm:px-6 lg:px-8">
        <article data-pagefind-body>
            <!-- Header Card -->
            <div
                class="rounded-2xl border border-neutral-200 dark:border-neutral-800 shadow-card bg-white dark:bg-neutral-900 p-5 sm:p-7 mb-8"
            >
                <div class="flex flex-col md:flex-row gap-6 items-start">
                    <!-- Logo -->
                    {
                        resolvedImage && (
                            <div class="flex-shrink-0">
                                <div class="w-24 h-24 sm:w-32 sm:h-32 overflow-hidden rounded-2xl bg-neutral-100 dark:bg-neutral-800 p-2">
                                    <Image
                                        class="w-full h-full object-contain"
                                        src={resolvedImage}
                                        alt={company.data.name}
                                        loading="eager"
                                        format="webp"
                                        width={128}
                                        height={128}
                                    />
                                </div>
                            </div>
                        )
                    }

                    <!-- Info -->
                    <div class="flex-1 min-w-0">
                        <h1
                            class="text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight leading-tight text-gray-900 dark:text-gray-100"
                        >
                            {company.data.name}
                        </h1>

                        <!-- Meta info -->
                        <div
                            class="mt-2 flex flex-wrap gap-3 text-sm text-gray-600 dark:text-gray-400"
                        >
                            {company.data.founded && <span>Founded {company.data.founded}</span>}
                            {company.data.location && <span>• {company.data.location}</span>}
                        </div>

                        <!-- Domain chips -->
                        {
                            company.data.domains && company.data.domains.length > 0 && (
                                <div class="mt-3 flex flex-wrap gap-2">
                                    {company.data.domains.map((domain: string) => {
                                        const dm = getDomainMeta(domain);
                                        return (
                                            <Badge variant="secondary" className="gap-1">
                                                <span aria-hidden="true">{dm.icon}</span>
                                                {dm.label}
                                            </Badge>
                                        );
                                    })}
                                </div>
                            )
                        }

                        <!-- Tags -->
                        {
                            company.data.tags && company.data.tags.length > 0 && (
                                <div class="mt-3 flex flex-wrap gap-2">
                                    {company.data.tags.slice(0, 8).map((tag: string) => (
                                        <Badge variant="outline">#{tag}</Badge>
                                    ))}
                                </div>
                            )
                        }

                        <!-- Primary CTA -->
                        {
                            primaryCTALabel && primaryCTAUrl && (
                                <a
                                    href={primaryCTAUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center justify-center px-5 py-2.5 sm:px-6 sm:py-3 text-sm sm:text-base font-semibold rounded-xl transition-colors mt-4 bg-primary-600 hover:bg-primary-700 text-white dark:bg-primary-500 dark:hover:bg-primary-400 shadow-card hover:shadow-card-hover"
                                >
                                    {primaryCTALabel}
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="w-4 h-4 ml-2"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                        />
                                    </svg>
                                </a>
                            )
                        }
                    </div>
                </div>
            </div>

            <!-- Description -->
            {
                company.data.description && (
                    <div class="mb-8">
                        <p class="text-base sm:text-lg text-neutral-700 dark:text-neutral-300 leading-relaxed">
                            {company.data.description}
                        </p>
                    </div>
                )
            }

            <!-- Social Links -->
            {
                company.data.socials && company.data.socials.length > 0 && (
                    <div class="mb-8">
                        <h2 class="text-lg font-semibold mb-3">Connect</h2>
                        <div class="flex flex-wrap gap-3">
                            {company.data.socials.map((social: Link) => (
                                <a
                                    href={social.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors text-sm font-medium"
                                >
                                    {social.label}
                                </a>
                            ))}
                        </div>
                    </div>
                )
            }

            <!-- Team Members -->
            {
                companyMembers.length > 0 && (
                    <div class="mb-8">
                        <h2 class="text-lg font-semibold mb-3">Team</h2>
                        <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-4">
                            {companyMembers.map((member) => {
                                const memberRole = (
                                    company.data.members as CompanyMember[] | undefined
                                )?.find((m) => m.slug === member.slug)?.role;
                                return (
                                    <a
                                        href={`/people/${member.slug}`}
                                        class="flex items-center gap-3 p-3 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:border-primary-500 dark:hover:border-primary-500 transition-colors"
                                    >
                                        <div class="w-10 h-10 rounded-full bg-neutral-200 dark:bg-neutral-700 flex items-center justify-center text-sm font-semibold">
                                            {member.data.name.charAt(0)}
                                        </div>
                                        <div>
                                            <div class="font-medium">{member.data.name}</div>
                                            {memberRole && (
                                                <div class="text-xs text-neutral-500">
                                                    {memberRole}
                                                </div>
                                            )}
                                        </div>
                                    </a>
                                );
                            })}
                        </div>
                    </div>
                )
            }

            <!-- Apps by this company -->
            {
                appsByCompany.length > 0 && (
                    <div class="mb-8">
                        <h2 class="text-lg font-semibold mb-3">Apps</h2>
                        <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-4">
                            {appsByCompany.map((app) => (
                                <a
                                    href={`/apps/${app.slug}`}
                                    class="block p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 hover:border-primary-500 dark:hover:border-primary-500 transition-colors"
                                >
                                    <h3 class="font-semibold">{app.data.title}</h3>
                                    <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 mt-1">
                                        {app.data.description}
                                    </p>
                                </a>
                            ))}
                        </div>
                    </div>
                )
            }

            <!-- Content from MDX -->
            <div class="prose prose-lg dark:prose-dark max-w-none">
                <Content />
            </div>
        </article>
    </div>
</BaseLayout>
