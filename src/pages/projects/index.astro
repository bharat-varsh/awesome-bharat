---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentCardFull from '@/components/ContentCardFull.astro';
import CollectionHero from '@/components/CollectionHero.astro';
import { getPrimaryCTAUrl, getPrimaryCTALabel } from '@/utils/ctaUtils.ts';
import { resolveLogo } from '@/utils/imageResolvers.ts';
import { getDomainMeta } from '@/utils/domainMeta.ts';

const projects = (await getCollection('projects')) as Array<CollectionEntry<'projects'>>;
const visibleProjects = projects
    .filter((project) => !project.data.draft)
    .sort((a, b) => {
        if (a.data.featured && !b.data.featured) return -1;
        if (!a.data.featured && b.data.featured) return 1;
        return a.data.name.localeCompare(b.data.name);
    });
---

<BaseLayout
    title="Projects | Awesome Bharat"
    description="Open-source projects built by Indian developers that the world depends on"
>
    <div class="max-w-7xl mx-auto px-4 py-10 sm:px-6 lg:px-8">
        <div class="mb-10">
            <CollectionHero
                title="Projects"
                description="Open-source projects built by Indian developers that the world depends on"
                countLabel={`${visibleProjects.length} projects`}
                icon="🔧"
                eyebrow="Collection"
            />
        </div>

        <div
            class="animate-fade-in grid
        grid-cols-[repeat(auto-fit,minmax(280px,1fr))]
        gap-6"
        >
            {
                visibleProjects.map((project) => {
                    const ctaLabel = getPrimaryCTALabel('projects', project.data);
                    const ctaUrl = getPrimaryCTAUrl('projects', project.data);

                    return (
                        <ContentCardFull
                            title={project.data.name}
                            description={project.data.description}
                            slug={project.slug}
                            collection="projects"
                            logoSrc={
                                project.data.logo
                                    ? resolveLogo(project.slug, project.data.logo)
                                    : undefined
                            }
                            domains={(project.data.domains ?? []).map(
                                (d: string) => getDomainMeta(d).label
                            )}
                            ctaLabel={ctaLabel}
                            ctaUrl={ctaUrl}
                            featured={project.data.featured}
                        />
                    );
                })
            }
        </div>
    </div>
</BaseLayout>
